  },
  {
   "keys": [
    "C-c"
   ]
  },
  {
   "wait": 2.5
  },
  {
   "screen": "after-exit",
   "scroll": 60
  },
  {
   "sh": "tmux -L unsent-072 display -p -t $SESS 'dead=#{pane_dead} status=#{pane_dead_status}'; pgrep -fl \"$RIG/bin/agy\" || echo 'no agy left'; echo '--- the draft anywhere under the scratch home?'; grep -rl 'a draft that the exit throws away' \"$RIG/home\" \"$RIG/tmp\" 2>/dev/null | sed \"s|$RIG|RIG|\"; echo '(nothing above means it is in no file)'",
   "save": "exit"
  }
 ],
