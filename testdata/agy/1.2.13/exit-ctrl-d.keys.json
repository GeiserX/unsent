{
 "name": "exit-ctrl-d",
 "size": [
  120,
  40
 ],
 "cmd": [
  "/Volumes/Data/unsent-072.VIQD/bin/unsent",
  "capture",
  "agy"
 ],
 "steps": [
  {
   "until": "\\? for shortcuts",
   "timeout": 120
  },
  {
   "wait": 1.5
  },
  {
   "screen": "empty"
  },
  {
   "keys": [
    "C-d"
   ]
  },
  {
   "wait": 1.0
  },
  {
   "screen": "one-ctrl-d"
  },
  {
   "keys": [
    "C-d"
   ]
  },
  {
   "wait": 2.5
  },
  {
   "screen": "after-exit",
   "scroll": 60
  },
  {
   "sh": "tmux -L unsent-072 display -p -t $SESS 'dead=#{pane_dead} status=#{pane_dead_status}'; pgrep -fl \"$RIG/bin/agy\" || echo 'no agy left'",
   "save": "exit"
  }
 ],
