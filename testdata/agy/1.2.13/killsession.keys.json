{
 "name": "killsession",
 "size": [
  120,
  40
 ],
 "cmd": [
  "/Volumes/Data/unsent-072.VIQD/bin/unsent",
  "capture",
  "agy"
 ],
 "steps": [
  {
   "until": "\\? for shortcuts",
   "timeout": 120
  },
  {
   "wait": 1.5
  },
  {
   "type": "kill session draft yankee"
  },
  {
   "keys": [
    "C-j"
   ]
  },
  {
   "type": "second row of it"
  },
  {
   "wait": 1.0
  },
  {
   "screen": "before-kill"
  },
  {
   "killsession": true
  },
  {
   "wait": 2.0
  },
  {
   "sh": "sleep 1; ps -o pid,stat,command -ax | grep -E 'bin/agy|bin/unsent' | grep -v grep; echo '--- the draft anywhere under the scratch home?'; grep -rl 'kill session draft yankee' \"$RIG/home\" \"$RIG/tmp\" 2>/dev/null | sed \"s|$RIG|RIG|\"; echo '(nothing above means it is in no file)'",
   "save": "ks-after"
  }
 ],
